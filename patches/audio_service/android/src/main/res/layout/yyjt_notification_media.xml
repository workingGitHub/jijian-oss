<?xml version="1.0" encoding="utf-8"?>
<!--
  声坞自定义媒体通知布局(vendor fork 补丁)。

  配色对齐 App 暖纸主题(packages/shared_ui AppColors.light):
    - 背景:accentSoft #F1E6D9(与首页 Hero 播放框渐变起点同色)
    - 文件名(主题字):foreground #2D201A(暖墨,非纯白,清晰可读)
    - 专辑名:accent #6B3F26(暖棕,与首页 Hero 专辑名同色)
    - APP 名:muted #8A7E74(弱化)
    - 控件图标:accent #6B3F26(由代码侧 setColorFilter 染色,非系统默认白色)
    - 描边:border #E8E0D5(hairline)

  布局结构(与首页第一行播放框一致):
    ┌────────────────────────────────────────────┐
    │ ┌─────────┐  [app_icon] 声坞            │  行1: APP图标 + APP名
    │ │         │  音乐文件名称(大/粗)            │  行2: 标题(文件名,主题字)
    │ │ 封面大图 │  专辑名称                       │  行3: 专辑名
    │ │  (左侧) │  [◁]  [▶]  [▷]                 │  行4: 上一首/播放/下一首
    │ └─────────┘                                 │
    └────────────────────────────────────────────┘
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/yyjt_root"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:orientation="horizontal"
    android:background="#F1E6D9"
    android:padding="8dp">

    <!-- 左:专辑封面大图(96dp 正方形,圆角由代码侧 setClipToOutline 实现) -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_vertical">

        <ImageButton
            android:id="@+id/yyjt_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:contentDescription="@string/yyjt_notification_art_desc" />
    </FrameLayout>

    <!-- 右:四行垂直布局 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- 行1: APP 图标(小)+ APP 名称 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/yyjt_app_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/yyjt_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="声坞"
                android:textColor="#8A7E74"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 行2: 音乐文件名(主题字,大且粗) — 暖墨 foreground 色,非白色 -->
        <TextView
            android:id="@+id/yyjt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#2D201A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- 行3: 专辑名称 — 暖棕 accent 色 -->
        <TextView
            android:id="@+id/yyjt_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B3F26"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- 行4: 三个播放控件(占满剩余高度,底部对齐) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="bottom|start"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/yyjt_btn_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:background="#00000000"
                android:contentDescription="@string/yyjt_notification_prev_desc" />

            <ImageButton
                android:id="@+id/yyjt_btn_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerInside"
                android:background="#00000000"
                android:contentDescription="@string/yyjt_notification_play_desc" />

            <ImageButton
                android:id="@+id/yyjt_btn_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerInside"
                android:background="#00000000"
                android:contentDescription="@string/yyjt_notification_next_desc" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
